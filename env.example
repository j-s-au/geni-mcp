# Copy to ~/.config/geni-mcp/env and chmod 600.
GENI_CLIENT_ID=your_app_id
GENI_CLIENT_SECRET=your_app_secret
GENI_REDIRECT_URI=http://geni-mcp.test:3000/oauth/callback

# readonly | safe (default) | full
#GENI_WRITE_LEVEL=safe
# Minimum gap between API requests in ms (default 2000). Slower when Geni's X-API-Rate-* headers ask for it.
#GENI_MIN_INTERVAL_MS=2000
#GENI_MAX_RETRIES=3
# Colon-separated folders that uploads may come from (default ~/Documents)
#GENI_UPLOAD_DIRS=/home/you/Documents/Genealogy
# Defaults: ~/.config/geni-mcp/tokens.json and ~/.config/geni-mcp/audit.jsonl
#GENI_TOKEN_FILE=
#GENI_AUDIT_LOG=
