{
  "name": "geni-mcp",
  "version": "0.1.0",
  "description": "Comprehensive MCP server for the Geni.com genealogy API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
