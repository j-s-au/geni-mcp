  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "bin": {
    "geni-mcp": "dist/index.js"
  },
  "private": true,
  "engines": {
    "node": ">=20"
